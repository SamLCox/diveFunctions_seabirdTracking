#' Angle average
#' 
#' @param x angle in radians.
#' @keywords internal angle
#' @export
#' @examples 
#' agl_mean(c(-pi, pi))
agl_mean <- function(x) {
  sinr <- sum(sin(x), na.rm = TRUE)
  cosr <- sum(cos(x), na.rm = TRUE)
  atan2(sinr, cosr)
}

